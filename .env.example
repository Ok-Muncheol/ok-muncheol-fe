# .env로 복사해 로컬 값을 넣는다(.env는 커밋하지 않는다). 아래 값은 모두 브라우저 번들에 실려 공개되므로
# NEXT_PUBLIC_을 붙이고, DB·LLM·VLM·Modal·Supabase secret key 같은 비밀은 넣지 않는다(BE 몫, README 「기술 구성」).
# NEXT_PUBLIC_BACKEND_URL은 공통 API 클라이언트(src/lib/api/client.ts)가 읽는다. Supabase 두 값은 인증·업로드(A)를 연결할 때 쓴다(아직 읽는 코드 없음).

# BE API 주소. 비우면 클라이언트가 로컬 BE(http://127.0.0.1:8000)를 쓴다.
# 운영 값은 별도 Vercel 프로젝트인 BE 주소(https://ok-muncheol-be.vercel.app)이고 끝에 /를 붙이지 않는다.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Supabase 로그인·Storage 직접 업로드·Realtime에 쓰는 프로젝트 주소와 publishable key(sb_publishable_…)
# 주소는 BE와 같은 Supabase 프로젝트다. secret key(sb_secret_…)는 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
