# .env로 복사해 로컬 값을 넣는다(.env는 커밋하지 않는다). NEXT_PUBLIC_ 값은 브라우저 번들에 실려 공개되므로
# DB·LLM·VLM·Modal·Supabase secret key 같은 비밀은 넣지 않는다(BE 몫, README 「기술 구성」). 맨 아래 OKM_DATA_SOURCE·DEMO_LOGIN_*는 서버에서만 읽는다.
# NEXT_PUBLIC_BACKEND_URL은 공통 API 클라이언트(src/lib/api/client.ts)가 읽는다. Supabase 두 값은 로그인·세션(src/lib/supabase/)이 읽고, 비우면 로그인 없이 동작한다.

# BE API 주소. 비우면 클라이언트가 로컬 BE(http://127.0.0.1:8000)를 쓴다.
# 운영 값은 별도 Vercel 프로젝트인 BE 주소(https://ok-muncheol-be.vercel.app)이고 끝에 /를 붙이지 않는다.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Supabase 로그인·Storage 직접 업로드·Realtime에 쓰는 프로젝트 주소와 publishable key(sb_publishable_…)
# 주소는 BE와 같은 Supabase 프로젝트다. secret key(sb_secret_…)는 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 화면 데이터 출처(서버에서만 읽고 브라우저에 실리지 않는다, 비밀 아님). api면 위 BE를, 비우거나 다른 값이면 합성 견본을 읽는다.
# 운영 배포(VERCEL_ENV=production)는 이 값과 상관없이 늘 BE를 읽는다. 로컬 BE는 APP_ENV=local·DEV_ACTOR_ID·CORS_ALLOW_ORIGINS로 띄운다.
OKM_DATA_SOURCE=

# 시연 계정 로그인 버튼(로그인 화면의 대물 담당자·대인 담당자·관리자 — src/features/auth/demo-accounts.ts). 서버에서만 읽고 브라우저에 실리지 않는다.
# 저장소가 공개라 실제 이메일·비밀번호는 여기 적지 않고 .env·Vercel 환경변수에만 넣는다. 비밀번호가 비면 버튼이 없고, 이메일이 빈 역할은 그 버튼만 없다.
# 운영 배포에 넣으면 주소를 아는 누구나 그 역할로 들어와 접수 등록·판단 실행까지 할 수 있다. 시연 기간에만 넣는다.
DEMO_LOGIN_PASSWORD=
DEMO_LOGIN_PROPERTY_EMAIL=
DEMO_LOGIN_INJURY_EMAIL=
DEMO_LOGIN_ADMIN_EMAIL=
